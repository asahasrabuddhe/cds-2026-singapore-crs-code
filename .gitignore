# Build output. Anchored, because an unanchored name also matches the
# cmd/ source directory of the same name.
/mycontainer
/img2rootfs

# Where images lived before they moved to /var/lib/mycontainer/rootfs,
# in case an old clone still has them.
/rootfs/

# A folder shared into the VM keeps a file deleted while open under this
# name until it is closed.
.fuse_hidden*

# The multipass client caches its update check in the working directory.
/network-cache/
